# Active chain: eth-mainnet | eth-sepolia | hardhat | tron-mainnet | tron-shasta
VITE_CHAIN=eth-sepolia

# Single Alchemy API key — RPC URL is derived from VITE_CHAIN automatically.
VITE_ALCHEMY_API_KEY=YOUR_ALCHEMY_KEY

# Uniswap Routing API (public endpoint, no key required for low volume)
VITE_UNISWAP_ROUTING_API_URL=https://api.uniswap.org/v2/quote
VITE_UNISWAP_API_KEY=

# Project token addresses (update per deployment / chain)
VITE_A7A5_ADDRESS=0x0000000000000000000000000000000000000000
VITE_WA7A5_ADDRESS=0x0000000000000000000000000000000000000000
VITE_UNIV2_PAIR_USDT_A7A5=0x0000000000000000000000000000000000000000
VITE_UNIV3_POOL_USDT_WA7A5=0x0000000000000000000000000000000000000000
VITE_UNIV3_FEE_TIER=500

# WalletConnect Cloud project ID (optional)
VITE_WALLETCONNECT_PROJECT_ID=

# ── ERC-4337 passkey smart account (optional) ───────────────────────────────
VITE_ENTRYPOINT_V08=0x0000000071727De22E5E9d8BAf0edAc6f37da032
VITE_ACCOUNT_FACTORY=
VITE_A7A5_PAYMASTER=
VITE_USDT_PAYMASTER=
VITE_POOLS_FACADE=
VITE_BUNDLER_URL=
# Pre-registered passkey P-256 coords (hex); usually set via browser after Create passkey
VITE_PASSKEY_QX=
VITE_PASSKEY_QY=
