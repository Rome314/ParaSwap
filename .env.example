# Active chain: eth-mainnet | eth-sepolia | hardhat | tron-mainnet | tron-shasta
VITE_CHAIN=eth-sepolia

# Single Alchemy API key — RPC URL is derived from VITE_CHAIN automatically.
VITE_ALCHEMY_API_KEY=YOUR_ALCHEMY_KEY

# Uniswap Routing API (public endpoint, no key required for low volume)
VITE_UNISWAP_ROUTING_API_URL=https://api.uniswap.org/v2/quote
VITE_UNISWAP_API_KEY=

# Project token addresses (update per deployment / chain)
VITE_A7A5_ADDRESS=0x6fA0BE17e4beA2fCfA22ef89BF8ac9aab0AB0fc9
VITE_WA7A5_ADDRESS=0xF442fF10b8deF89514560A66C0AD28777094636a
VITE_UNIV2_PAIR_USDT_A7A5=0x14D7AAB5b4bca6a02E52aC22520B033bF35F4091
VITE_UNIV3_POOL_USDT_WA7A5=0xB6d629cb247333DD5e273B75741c55DfEca6f6e9
VITE_UNIV3_FEE_TIER=500

# Deployed project contracts (subgraph + Go backend — picked up by npm run build:contracts)
PARASWAP_ADDRESS=0x0000000000000000000000000000000000000000
POOLS_FACADE_ADDRESS=0x0000000000000000000000000000000000000000

# Go backend (backend/)
PORT=8080
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Subgraph / local graph node
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
GRAPH_DEPLOY_KEY=
GRAPH_NODE_URL=http://localhost:8020/

# Hardhat fork tests (blockchain/)
ALCHEMY_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
A7A5_ADDRESS=0x6fA0BE17e4beA2fCfA22ef89BF8ac9aab0AB0fc9
WA7A5_ADDRESS=0xF442fF10b8deF89514560A66C0AD28777094636a

# WalletConnect Cloud project ID (optional)
VITE_WALLETCONNECT_PROJECT_ID=
