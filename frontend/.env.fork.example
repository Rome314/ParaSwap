# Copy to .env.local for mainnet-fork debug dashboard workflow.
# Addresses are printed by: cd blockchain && npm run fork:deploy

VITE_CHAIN=hardhat-fork
VITE_FORK_RPC_URL=http://127.0.0.1:8545
VITE_BUNDLER_URL=http://127.0.0.1:4337

# Canonical EntryPoint v0.8 (same on all chains)
VITE_ENTRYPOINT_V08=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108

# Paste from fork:deploy JSON output:
VITE_ACCOUNT_FACTORY=
VITE_EIP7702_DELEGATE=
VITE_A7A5_PAYMASTER=
VITE_USDT_PAYMASTER=
VITE_POOLS_FACADE=
VITE_PARASWAP=
VITE_A7A5_TWAP_ORACLE=
VITE_A7A5_NATIVE_ORACLE=
VITE_USDT_NATIVE_ORACLE=

# Mainnet token addresses (fork mirrors mainnet state)
VITE_A7A5_ADDRESS=0x6fA0BE17e4beA2fCfA22ef89BF8ac9aab0AB0fc9
VITE_WA7A5_ADDRESS=0xF442fF10b8deF89514560A66C0AD28777094636a
VITE_UNIV2_PAIR_USDT_A7A5=0x14D7AAB5b4bca6a02E52aC22520B033bF35F4091
VITE_UNIV3_POOL_USDT_WA7A5=0xB6d629cb247333DD5e273B75741c55DfEca6f6e9
VITE_UNIV3_FEE_TIER=500
VITE_CHAINLINK_USDT_ETH=0xEe9F2375b4bdF6387aa8265dD4FB8F16512A1d46

# Optional — passkey coords are stored in browser after Create passkey
VITE_PASSKEY_QX=
VITE_PASSKEY_QY=
