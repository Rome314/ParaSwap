{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "rootDir": ".",
        "types": [
            "node",
            "mocha"
        ]
    },
    "allowImportingTsExtensions":true,
    "include": [
        "hardhat.config.ts",
        "test/**/*",
        "scripts/**/*",
        "common/**/*",
        "artifacts/**/*",
        "types/**/*"
    ]
}