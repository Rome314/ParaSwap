{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": ["error", "^0.8.22"],
    "func-visibility": ["warn", { "ignoreConstructors": true }],
    "reason-string": ["warn", { "maxLength": 64 }],
    "custom-errors": "warn",
    "named-return-values": "warn",
    "no-empty-blocks": "off",
    "no-unused-import": "warn"
  }
}
