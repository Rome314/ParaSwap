{
  "name": "para-swap-contracts",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "node ../scripts/hardhat-local.mjs build && npm run export-artifacts",
    "export-artifacts": "tsx scripts/export-artifacts.ts",
    "test": "node ../scripts/hardhat-local.mjs test mocha",
    "test:fork": "MAINNET_FORK=1 hardhat test mocha",
    "test:predeploy": "REQUIRE_FORK_TESTS=1 MAINNET_FORK=1 hardhat test mocha",
    "test:coverage": "node ../scripts/hardhat-local.mjs test mocha --coverage",
    "test:fork:aa": "MAINNET_FORK=1 hardhat test mocha 'test/Integration/*.test.ts' 'test/UsdtPaymaster/*.test.ts' 'test/A7A5AccountFactory/*.test.ts' 'test/A7A5EIP7702Account/*.test.ts' test/A7A5WebAuthnAccount/account-fork.test.ts",
    "anvil:fork": "bash scripts/anvil-fork.sh",
    "fork:demo": "MAINNET_FORK=1 hardhat run scripts/fork-setup-and-demo.ts",
    "diagnose:fork": "hardhat run scripts/diagnose-fork.ts",
    "node:fork": "MAINNET_FORK=1 hardhat node",
    "fork:deploy": "hardhat run scripts/fork-setup-and-demo.ts --network localhost --show-stack-traces",
    "fund:smart-account": "hardhat run scripts/fund-smart-account.ts --network localhost",
    "bundler:dev": "hardhat run scripts/dev-bundler.ts",
    "predeploy:prepare": "tsx scripts/prepare-deployment.ts",
    "deploy:mainnet": "npm run predeploy:prepare -- mainnet && hardhat ignition deploy ignition/modules/A7A5AA.ts --network mainnet --parameters .ignition-parameters/mainnet.json --verify",
    "deploy:sepolia": "npm run predeploy:prepare -- sepolia && hardhat ignition deploy ignition/modules/sepolia/A7A5AA_Sepolia.ts --network sepolia --parameters .ignition-parameters/sepolia.json --verify",
    "deploy:sepolia:dry-run": "hardhat ignition visualize ignition/modules/sepolia/A7A5AA_Sepolia.ts",
    "format": "prettier --write \"**/*.{sol,ts,js}\"",
    "format:check": "prettier --check \"**/*.{sol,ts,js}\"",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "lint:slither": "rm -f slither-report.sarif && slither . --config-file slither.config.json",
    "lint:slither:high": "rm -f slither-report.sarif && slither . --config-file slither.config.json --exclude medium --exclude low --exclude informational",
    "audit": "npm run format:check && npm run lint:sol && npm run build && npm run test:coverage && npm run lint:slither",
    "storage-layout": "hardhat compile && hardhat storage-layout",
    "test:gas": "node ../scripts/hardhat-local.mjs test mocha --gas-stats",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openzeppelin/community-contracts": "github:OpenZeppelin/openzeppelin-community-contracts#f7e5f08e8fd42023084eb41f4a992d7be897b915",
    "@openzeppelin/contracts": "5.6.1",
    "@uniswap/v2-core": "1.0.1",
    "@uniswap/v3-core": "1.0.1",
    "@uniswap/v3-periphery": "1.4.4",
    "a7a5": "github:a7a5-defi/a7a5#c3f5213b5c4cfb48687538f377f328c851adbd3d"
  },
  "devDependencies": {
    "@noble/curves": "1.9.7",
    "@nomicfoundation/hardhat-ethers": "4.0.13",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.10",
    "@nomicfoundation/hardhat-ignition": "3.1.7",
    "@nomicfoundation/hardhat-ignition-ethers": "3.1.6",
    "@nomicfoundation/hardhat-keystore": "3.0.12",
    "@nomicfoundation/hardhat-mocha": "3.0.21",
    "@nomicfoundation/hardhat-network-helpers": "3.0.10",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "@nomicfoundation/hardhat-typechain": "3.1.1",
    "@nomicfoundation/hardhat-verify": "3.0.19",
    "@nomicfoundation/ignition-core": "3.1.7",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "chai": "5.3.3",
    "dotenv": "16.6.1",
    "ethers": "6.16.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.2",
    "hardhat": "3.8.0",
    "mocha": "11.7.6",
    "prettier": "3.8.3",
    "prettier-plugin-solidity": "2.3.1",
    "solhint": "5.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
