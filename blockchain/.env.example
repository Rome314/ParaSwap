# Alchemy API key (or set ALCHEMY_RPC_URL to a full mainnet RPC URL).
# Used by hardhat.config.ts to fork Ethereum mainnet.
ALCHEMY_API_KEY=
# ALCHEMY_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>

# Optional: pin the fork to a block for deterministic tests.
# FORK_BLOCK=20000000

# Fork-only tests (gating / swaps) are skipped unless this is set.
# MAINNET_FORK=1

# Optional whale / role overrides for fork funding (defaults live in test/addresses.ts).
# A7A5_WHALE=
# WA7A5_WHALE=
# USDT_WHALE=
