# Alchemy RPC (mainnet fork tests + deployment)
ALCHEMY_API_KEY=
ALCHEMY_RPC_URL=
SEPOLIA_RPC_URL=

# Fork test toggle and optional block pin (P-256 precompile needs recent mainnet)
# Use: npm run test:fork  — do NOT add --coverage to fork test runs (breaks EDR fork)
MAINNET_FORK=1
FORK_BLOCK=

# Canonical EntryPoint v0.8 singleton
ENTRYPOINT=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108

# Paymaster operational funding (ETH deposited to EntryPoint)
DEPOSIT_ETH=5
STAKE_ETH=1

# Deployer key for mainnet/sepolia ignition deploys
DEPLOYER_PRIVATE_KEY=

# Etherscan API key (contract verification on deploy --verify)
ETHERSCAN_API_KEY=

# Sepolia-only: set feedUpdatedAt in ignition/parameters/sepolia.json to a recent
# unix timestamp before deploy so mock Chainlink answers are not immediately stale.

# Deployed AA stack (filled by fork:demo or ignition)
A7A5_PAYMASTER=
USDT_PAYMASTER=
ACCOUNT_FACTORY=
